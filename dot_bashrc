# ~/.bashrc — minimal bash fallback (primary interactive shell is zsh; see dot_zshrc)

# RVM to PATH (kept last among PATH changes, per RVM scripting guidance)
export PATH="$PATH:$HOME/.rvm/bin"

# Tool environment hooks. Each is guarded so a fresh machine that does not
# have the tool installed does not break bash startup with a failed source.
[[ -s "$HOME/.rover/env" ]] && source "$HOME/.rover/env"
[[ -s "$HOME/.langflow/uv/env" ]] && . "$HOME/.langflow/uv/env"
[[ -s "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# LM Studio CLI (lms)
[[ -d "$HOME/.lmstudio/bin" ]] && export PATH="$PATH:$HOME/.lmstudio/bin"
