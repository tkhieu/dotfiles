# ~/.bashrc — bash fallback (primary interactive shell is zsh; see dot_zshrc).
# Also used by non-zsh tools that spawn bash (e.g. Claude Code's Bash tool).

# Keep the distro defaults (prompt, completion, aliases). Fedora and macOS only
# read /etc/bashrc through ~/.bashrc; Debian/Ubuntu bash reads /etc/bash.bashrc itself.
if [[ -f /etc/bashrc ]]; then
  . /etc/bashrc
fi

# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# User-local binaries (Claude Code installer target), ~/bin and pnpm globals
export PNPM_HOME="$HOME/.local/share/pnpm"
for dir in "$PNPM_HOME/bin" "$HOME/bin" "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
done

# Runtimes managed by mise (node, per-project versions)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

# Tool environment hooks. Each is guarded so a fresh machine that does not
# have the tool installed does not break bash startup with a failed source.
[[ -s "$HOME/.rover/env" ]] && source "$HOME/.rover/env"
[[ -s "$HOME/.langflow/uv/env" ]] && . "$HOME/.langflow/uv/env"
[[ -s "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# LM Studio CLI (lms)
[[ -d "$HOME/.lmstudio/bin" ]] && export PATH="$PATH:$HOME/.lmstudio/bin"

# Grok CLI
if [[ -d "$HOME/.grok/bin" ]]; then
  export PATH="$HOME/.grok/bin:$PATH"
  [[ -r "$HOME/.grok/completions/bash/grok.bash" ]] && . "$HOME/.grok/completions/bash/grok.bash"
fi

# aws-vault on Linux: use the passphrase-protected file backend (~/.awsvault/keys).
# The login keyring unlocks itself at login, so it does not protect credentials.
[[ "$(uname -s)" == Linux ]] && export AWS_VAULT_BACKEND=file

# Machine-specific additions that are not managed by chezmoi
if [[ -d "$HOME/.bashrc.d" ]]; then
  for rc in "$HOME"/.bashrc.d/*; do
    [[ -f "$rc" ]] && . "$rc"
  done
  unset rc
fi
