{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
# Update Homebrew and pnpm globals on every apply. Distro packages (dnf/apt) are
# left to the system updater so an apply never needs sudo on a set-up machine.
set -euo pipefail

for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x "$brew_bin" ]]; then
    eval "$("$brew_bin" shellenv)"
    break
  fi
done

if command -v brew >/dev/null 2>&1; then
  echo "Updating Homebrew packages..."
  brew update && brew upgrade
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s bash)"
fi

if ! command -v pnpm >/dev/null 2>&1; then
  exit 0
fi

echo "Updating pnpm global packages..."
# chezmoi runs this in a non-interactive shell that does not source ~/.zshrc,
# so replicate the PNPM_HOME/PATH setup — pnpm refuses global operations when
# its global bin dir is not on PATH. pnpm 11+ uses "$PNPM_HOME/bin" as the
# global bin dir; "$PNPM_HOME" is kept for pre-11 layout compatibility.
export PNPM_HOME="$HOME/.local/share/pnpm"
for dir in "$PNPM_HOME/bin" "$PNPM_HOME"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
done

# Scrub bogus "@pnpm/exe" global roots before update -g.
# Cause: brew-managed pnpm occasionally self-installs as a global, creating a
# root whose package.json points "@pnpm/exe" at "file:/home/linuxbrew/.linuxbrew/bin"
# (not a real package). The resulting empty node_modules/@pnpm/exe makes any
# subsequent "pnpm update -g" exit 254 with ENOENT.
for d in "$PNPM_HOME/global/v11"/*/; do
  [[ -f "$d/package.json" ]] && grep -q '"@pnpm/exe"' "$d/package.json" && rm -rf "$d"
done

pnpm update -g
{{ end -}}
