# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- OS Detection ---
case "$(uname -s)" in
  Darwin) _OS="macos" ;;
  Linux)  _OS="linux" ;;
  *)      _OS="other" ;;
esac

# --- Homebrew ---
if [[ "$_OS" == "macos" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "$_OS" == "linux" && -d /home/linuxbrew/.linuxbrew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# --- Antigen (plugin manager) ---
if [[ "$_OS" == "macos" ]]; then
  _antigen_path="$(brew --prefix)/share/antigen/antigen.zsh"
elif [[ "$_OS" == "linux" ]]; then
  _antigen_path="/home/linuxbrew/.linuxbrew/share/antigen/antigen.zsh"
fi
if [[ -f "$_antigen_path" ]]; then
  source "$_antigen_path"

  antigen use oh-my-zsh

  # plugins
  antigen bundle git
  # antigen bundle node  # Disabled: conflicts with zsh-nvm lazy loading
  # antigen bundle npm
  antigen bundle aws
  antigen bundle pip
  antigen bundle terraform
  antigen bundle heroku
  antigen bundle git-extras
  antigen bundle zsh-users/zsh-autosuggestions
  antigen bundle zdharma-continuum/fast-syntax-highlighting
  antigen bundle djui/alias-tips

  # theme
  antigen theme romkatv/powerlevel10k

  # nvm-zsh (lazy loading)
  export NVM_DIR="$HOME/.nvm"
  export NVM_COMPLETION=true
  export NVM_LAZY_LOAD=true
  export NVM_AUTO_USE=true
  antigen bundle lukechilds/zsh-nvm

  antigen apply
fi
unset _antigen_path

# --- JBang ---
if [[ -d "$HOME/.jbang" ]]; then
  alias j!=jbang
  export PATH="$HOME/.jbang/bin:$PATH"
fi

# --- Kube Krew ---
if [[ -d "${KREW_ROOT:-$HOME/.krew}" ]]; then
  export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
fi

# --- Google Cloud SDK (macOS only) ---
if [[ "$_OS" == "macos" ]]; then
  if [[ -f '/Users/hieu.t/google-cloud-sdk/path.zsh.inc' ]]; then
    source '/Users/hieu.t/google-cloud-sdk/path.zsh.inc'
  fi
  if [[ -f '/Users/hieu.t/google-cloud-sdk/completion.zsh.inc' ]]; then
    source '/Users/hieu.t/google-cloud-sdk/completion.zsh.inc'
  fi
fi

# --- pyenv ---
if command -v pyenv &>/dev/null; then
  export PYENV_ROOT="$HOME/.pyenv"
  [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

# --- RVM ---
if [[ -d "$HOME/.rvm" ]]; then
  export PATH="$PATH:$HOME/.rvm/bin"
fi

# --- p10k ---
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# --- asdf ---
if command -v asdf &>/dev/null || [[ -d "${ASDF_DATA_DIR:-$HOME/.asdf}" ]]; then
  export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fi

# --- Ruby gems ---
if [[ -d "$HOME/.gem/ruby/3.3.0" ]]; then
  export PATH="$PATH:$HOME/.gem/ruby/3.3.0"
fi

# --- Dart CLI completion (macOS only) ---
if [[ "$_OS" == "macos" && -f /Users/hieu.t/.dart-cli-completion/zsh-config.zsh ]]; then
  source /Users/hieu.t/.dart-cli-completion/zsh-config.zsh
fi

# --- Android SDK ---
if [[ "$_OS" == "macos" ]]; then
  export ANDROID_HOME=~/Library/Android/sdk
  export NDK_HOME=/Users/hieu.t/Library/Android/sdk/ndk/27.1.12297006
elif [[ "$_OS" == "linux" && -d "$HOME/Android/Sdk" ]]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
fi
if [[ -n "$ANDROID_HOME" && -d "$ANDROID_HOME" ]]; then
  export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools"
fi

# --- SDKMAN ---
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  export SDKMAN_DIR="$HOME/.sdkman"
  source "$HOME/.sdkman/bin/sdkman-init.sh"
fi

# --- Conda ---
if [[ "$_OS" == "macos" ]]; then
  _conda_bin="/opt/homebrew/Caskroom/miniconda/base/bin/conda"
  _conda_profile="/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
  _conda_path="/opt/homebrew/Caskroom/miniconda/base/bin"
elif [[ "$_OS" == "linux" ]]; then
  _conda_bin="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/bin/conda"
  _conda_profile="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
  _conda_path="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/bin"
fi
if [[ -f "$_conda_bin" ]]; then
  __conda_setup="$("$_conda_bin" 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  elif [[ -f "$_conda_profile" ]]; then
    source "$_conda_profile"
  else
    export PATH="$_conda_path:$PATH"
  fi
  unset __conda_setup
fi
unset _conda_bin _conda_profile _conda_path

# --- Windsurf/Codeium (macOS only) ---
if [[ "$_OS" == "macos" && -d "/Users/hieu.t/.codeium/windsurf/bin" ]]; then
  export PATH="/Users/hieu.t/.codeium/windsurf/bin:$PATH"
fi

# --- pnpm ---
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# --- DNSControl ---
if command -v dnscontrol &>/dev/null; then
  eval "$(dnscontrol shell-completion zsh)"
fi

# --- Aliases ---
alias ccd='claude --dangerously-skip-permissions'
if command -v fvm &>/dev/null; then
  alias flutter='fvm flutter'
  alias dart='fvm dart'
fi

# --- Bun ---
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
elif [[ "$_OS" == "macos" && -s "/Users/hieu.t/.bun/_bun" ]]; then
  source "/Users/hieu.t/.bun/_bun"
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# --- LM Studio (macOS only) ---
if [[ "$_OS" == "macos" && -d "/Users/hieu.t/.lmstudio/bin" ]]; then
  export PATH="$PATH:/Users/hieu.t/.lmstudio/bin"
fi

# --- Antigravity (macOS only) ---
if [[ "$_OS" == "macos" && -d "/Users/hieu.t/.antigravity/antigravity/bin" ]]; then
  export PATH="/Users/hieu.t/.antigravity/antigravity/bin:$PATH"
fi

unset _OS
