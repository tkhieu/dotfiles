# ~/.zshrc — fish-like zsh: antidote plugins, Starship prompt, mise runtimes.
# Plugin list lives in ~/.zsh_plugins.txt; antidote compiles it to a static file.

# --- OS Detection ---
case "$(uname -s)" in
  Darwin) _OS="macos" ;;
  Linux)  _OS="linux" ;;
  *)      _OS="other" ;;
esac

# --- Git signing: disable 1Password SSH agent when in SSH session ---
if [[ -n "$SSH_CONNECTION" ]]; then
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0="commit.gpgsign"
  export GIT_CONFIG_VALUE_0="false"
fi

# --- Homebrew ---
if [[ "$_OS" == "macos" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "$_OS" == "linux" && -d /home/linuxbrew/.linuxbrew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# --- History ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt AUTO_CD INTERACTIVE_COMMENTS

# --- Grok CLI (completion must be on fpath before compinit) ---
if [[ -d "$HOME/.grok/bin" ]]; then
  export PATH="$HOME/.grok/bin:$PATH"
  [[ -d "$HOME/.grok/completions/zsh" ]] && fpath=("$HOME/.grok/completions/zsh" "${fpath[@]}")
fi

# --- aws-vault on Linux: passphrase-protected file backend (~/.awsvault/keys) ---
# The login keyring unlocks itself at login, so it does not protect credentials.
[[ "$_OS" == "linux" ]] && export AWS_VAULT_BACKEND=file

# --- Plugins (antidote) ---
# Autosuggestions: suggest from history first, then from completion.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
_antidote="${HOMEBREW_PREFIX:-/nonexistent}/opt/antidote/share/antidote/antidote.zsh"
# oh-my-zsh lib is loaded as plain files; never run its self-update check.
zstyle ':omz:update' mode disabled
if [[ -r "$_antidote" ]]; then
  source "$_antidote"
  antidote load "$HOME/.zsh_plugins.txt"
  # Free the OMZ git-svn aliases (gsd, gsr) for other use.
  unalias gsd gsr 2>/dev/null
fi
unset _antidote

# --- Completion: menu selection, case-insensitive and partial-word matching ---
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# --- Key bindings: ↑/↓ search history by the typed prefix, Ctrl+←/→ by word ---
if (( $+functions[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey '^[OA' history-substring-search-up
  bindkey '^[OB' history-substring-search-down
fi
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# --- User-local binaries (e.g., Claude Code CLI installer target) and ~/bin ---
for _dir in "$HOME/bin" "$HOME/.local/bin"; do
  [[ -d "$_dir" ]] && export PATH="$_dir:$PATH"
done
unset _dir

# --- JBang ---
if [[ -d "$HOME/.jbang" ]]; then
  alias j!=jbang
  export PATH="$HOME/.jbang/bin:$PATH"
fi

# --- Kube Krew ---
if [[ -d "${KREW_ROOT:-$HOME/.krew}" ]]; then
  export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
fi

# --- Google Cloud SDK (macOS only) ---
if [[ "$_OS" == "macos" ]]; then
  if [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then
    source "$HOME/google-cloud-sdk/path.zsh.inc"
  fi
  if [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
    source "$HOME/google-cloud-sdk/completion.zsh.inc"
  fi
fi

# --- Ruby gems ---
if [[ -d "$HOME/.gem/ruby/3.3.0" ]]; then
  export PATH="$PATH:$HOME/.gem/ruby/3.3.0"
fi

# --- Dart CLI completion (macOS only) ---
if [[ "$_OS" == "macos" && -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]]; then
  source "$HOME/.dart-cli-completion/zsh-config.zsh"
fi

# --- Android SDK ---
if [[ "$_OS" == "macos" ]]; then
  export ANDROID_HOME=~/Library/Android/sdk
  export NDK_HOME="$HOME/Library/Android/sdk/ndk/27.1.12297006"
elif [[ "$_OS" == "linux" && -d "$HOME/Android/Sdk" ]]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
fi
if [[ -n "$ANDROID_HOME" && -d "$ANDROID_HOME" ]]; then
  export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools"
fi

# --- Conda ---
if [[ "$_OS" == "macos" ]]; then
  _conda_bin="/opt/homebrew/Caskroom/miniconda/base/bin/conda"
  _conda_profile="/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
  _conda_path="/opt/homebrew/Caskroom/miniconda/base/bin"
elif [[ "$_OS" == "linux" ]]; then
  _conda_bin="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/bin/conda"
  _conda_profile="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
  _conda_path="/home/linuxbrew/.linuxbrew/Caskroom/miniconda/base/bin"
fi
if [[ -f "$_conda_bin" ]]; then
  __conda_setup="$("$_conda_bin" 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  elif [[ -f "$_conda_profile" ]]; then
    source "$_conda_profile"
  else
    export PATH="$_conda_path:$PATH"
  fi
  unset __conda_setup
fi
unset _conda_bin _conda_profile _conda_path

# --- Windsurf/Codeium (macOS only) ---
if [[ "$_OS" == "macos" && -d "$HOME/.codeium/windsurf/bin" ]]; then
  export PATH="$HOME/.codeium/windsurf/bin:$PATH"
fi

# --- DNSControl ---
if command -v dnscontrol &>/dev/null; then
  eval "$(dnscontrol shell-completion zsh)"
fi

# --- Aliases ---
alias ccd='claude --dangerously-skip-permissions'
if command -v fvm &>/dev/null; then
  alias flutter='fvm flutter'
  alias dart='fvm dart'
fi

# --- Bun ---
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
elif [[ "$_OS" == "macos" && -s "$HOME/.bun/_bun" ]]; then
  source "$HOME/.bun/_bun"
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# --- LM Studio (macOS only) ---
if [[ "$_OS" == "macos" && -d "$HOME/.lmstudio/bin" ]]; then
  export PATH="$PATH:$HOME/.lmstudio/bin"
fi

# --- Antigravity (macOS only) ---
if [[ "$_OS" == "macos" && -d "$HOME/.antigravity/antigravity/bin" ]]; then
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi

unset _OS

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# --- Runtimes (mise: node, python via uv, per-project versions) ---
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# --- fzf: Ctrl+R history, Ctrl+T files, Alt+C directories ---
# Only on a terminal: without a TTY (e.g. editors running `zsh -i -c env`)
# fzf's key-binding script fails to restore the zle option and prints errors.
if [[ -t 0 ]] && command -v fzf &>/dev/null; then
  source <(fzf --zsh)
fi

# --- Prompt ---
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi
